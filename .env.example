# PETCARE BACKEND — chỉnh file .env, không chỉnh file mẫu để áp dụng cấu hình.
# Cách điền: chỉ sửa phần sau dấu =; giữ giá trị có khoảng trắng hoặc dấu # trong dấu nháy kép.
# Không gửi file .env thật lên Git/chat; chỉ chia sẻ file .env.example đã để trống key.
# Sau khi sửa: Ctrl+S, dừng petcare-be bằng Ctrl+C rồi chạy lại dev.
# Các chú thích không thay đổi giá trị đã điền. Không cần điền dịch vụ ngoài chưa sử dụng.
#
# Biến tùy chọn: chỉ thêm dòng cần dùng; các ví dụ còn dấu # không có hiệu lực.
# Khi thử local, có thể bỏ dấu # ở dòng sau:
# NODE_ENV=development
# Khi triển khai, dùng NODE_ENV=production thay cho development.
# HOST mặc định 0.0.0.0; chỉ khai báo khi cần đổi địa chỉ API lắng nghe.
# HOST=0.0.0.0
# CORS_ORIGIN là origin website được gọi API, không kèm đường dẫn. Ví dụ:
# CORS_ORIGIN="http://localhost:3000"
# Nếu chưa khai báo AI_KNOWLEDGE_INDEX_PATH, mặc định là .cache/ai/knowledge-index.json .

# 1. DATABASE — bắt buộc để lưu tài khoản, thú cưng, lịch và đơn hàng.
# Dạng: postgresql://USER:MAT_KHAU@HOST:CONG/DB?schema=public.
# API chạy trên máy, PostgreSQL theo Docker của dự án: HOST=localhost, CONG=5434, DB=petcare_db.
# Docker mới dùng USER=postgres, MAT_KHAU=postgres. DB cũ dùng thông tin đã được bàn giao.
# Chỉ sửa dòng này không đổi mật khẩu hay dữ liệu trong PostgreSQL.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/petcare?schema=public

# 2. CỔNG API — local giữ 3001. Website chạy riêng ở cổng 3000.
# Cloudflare Tunnel phải trỏ về http://localhost:3001, không phải 3000.
PORT=3001

# 3. PHIÊN ĐĂNG NHẬP — khóa do chủ dự án tự tạo, không lấy từ Google hay SePay.
# JWT_SECRET dùng ký access token (thẻ xác thực cho các request API).
# Dùng chuỗi ngẫu nhiên dài ít nhất 32 ký tự; không giữ giá trị mẫu và không dùng mật khẩu Admin.
# Đổi khóa này khiến access token cũ không còn hợp lệ.
JWT_SECRET=replace-with-a-random-secret

# Thời hạn access token. Ví dụ 15m = 15 phút; h = giờ, d = ngày.
# Giữ 15m nếu không có yêu cầu khác; ứng dụng dùng refresh token để làm mới phiên.
JWT_EXPIRES_IN="15m"

# Khóa ký refresh token (dùng xin access token mới).
# Tạo một chuỗi ngẫu nhiên khác JWT_SECRET, cũng dài ít nhất 32 ký tự.
# Đổi khóa này làm refresh token cũ không còn hợp lệ, người dùng cần đăng nhập lại.
JWT_REFRESH_SECRET=replace-with-a-random-refresh-secret

# Thời hạn refresh token. Ví dụ 7d = 7 ngày; giữ theo file mẫu nếu không cần thay đổi.
JWT_REFRESH_EXPIRES_IN="7d"

# 4. GOOGLE LOGIN — Client ID là mã ứng dụng, không phải API key hay mật khẩu Google.
# Giá trị dùng trên web nằm ở NEXT_PUBLIC_GOOGLE_CLIENT_ID trong petcare-fe/.env.local.
# Lấy OAuth Client ID loại Web application trong Google Cloud; khai báo origin http://localhost:3000 khi thử local.
# LƯU Ý CODE HIỆN TẠI: backend chưa đọc GOOGLE_CLIENT_ID trong luồng OAuth.
# Dòng này hiện chỉ giữ để đối chiếu cấu hình; điền nó không tự bật kiểm tra Google token phía server.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# 5. UPLOAD ẢNH — cần đủ ba biến CLOUDINARY để upload được ảnh.
# Mở Cloudinary Console → Settings → API Keys; lấy thông tin cùng một product environment.
# CLOUDINARY_CLOUD_NAME là tên cloud/environment, không phải tên tài khoản đăng nhập.
# Hướng dẫn: https://cloudinary.com/documentation/developer_onboarding_faq_find_credentials
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud

# API Key lấy cùng trang API Keys trên Cloudinary; phải thuộc cloud name phía trên.
# Key cần đang hoạt động và được phép upload; có key nhưng thiếu quyền vẫn có thể bị lỗi 403.
CLOUDINARY_API_KEY=your-cloudinary-api-key

# API Secret đi cùng API Key phía trên, dùng ký yêu cầu upload từ backend.
# Chỉ lưu ở backend; không đưa vào NEXT_PUBLIC_*, ảnh chụp màn hình hoặc Git.
# Chưa cấu hình Cloudinary thì các tính năng upload ảnh chưa dùng được.
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# 6. OTP KHI THỬ LOCAL — false: gửi mã qua Gmail SMTP như bình thường.
# True phải viết là true (chữ thường), chỉ có hiệu lực nếu NODE_ENV=development.
# Khi cả hai điều kiện đúng, API trả mã dev cho trang đăng nhập và không gửi email OTP.
# Luôn để false khi mở Cloudflare Tunnel hoặc triển khai cho người khác sử dụng.
# Admin/Staff đăng nhập bằng mật khẩu riêng, không cần bật lựa chọn này.
AUTH_DEV_OTP_PREVIEW=false

# 7. EMAIL — Gmail mà PetCare dùng để gửi OTP, thông báo và hóa đơn; không phải email khách nhận thư.
# Điền địa chỉ Gmail đầy đủ, ví dụ shop@gmail.com.
# SMTP đã cố định trong code: smtp.gmail.com, cổng 465, TLS; không cần thêm MAIL_HOST/MAIL_PORT.
MAIL_USER=your-email@example.com

# Mật khẩu ứng dụng Google (App Password) của đúng Gmail MAIL_USER, không phải mật khẩu đăng nhập Gmail.
# Bật Xác minh 2 bước rồi tạo App Password tại https://myaccount.google.com/apppasswords .
# Google thường hiển thị 16 ký tự theo nhóm; code tự bỏ khoảng trắng khi dùng.
# Bỏ trống MAIL_USER hoặc MAIL_PASS thì không gửi được thư/OTP thật.
# Kiểm tra cấu hình: mở terminal trong petcare-be, chạy npm.cmd run mail:verify (không gửi email).
# Hướng dẫn: https://support.google.com/accounts/answer/185833?hl=vi
MAIL_PASS=your-mail-app-password

# 8. TRỢ LÝ AI — lấy Gemini API key tại https://aistudio.google.com/apikey .
# Key này dùng chung cho trả lời hội thoại và tạo vector kiến thức (embedding).
# Key phải được cấp quyền/quota cho các model bên dưới; không phải Google OAuth Client ID.
# Để trống: không gọi được model Gemini; phản hồi dự phòng không chứng minh AI thật đã chạy.
# Chỉ lưu key ở backend. Chi tiết model/vector/log: docs/ai-assistant-deployment.md ở thư mục gốc.
GEMINI_API_KEY=your-gemini-api-key

# Tên model trả lời khách. Đây là tên model, không phải chỗ dán API key.
# Giữ model theo file mẫu hoặc dùng model mà tài khoản của bạn được phép gọi.
# Đổi biến này cần chạy lại API; theo dõi lượt dùng/lỗi trong Admin → Chatbot & kiến thức.
GEMINI_MODEL="gemini-3.1-flash-lite"

# Tên model biến tài liệu/câu hỏi thành vector để tìm kiến thức liên quan.
# Khác GEMINI_MODEL: model này phục vụ tìm tài liệu, không soạn câu trả lời.
# Khi đổi embedding model, API kiểm tra lại cache và tạo chỉ mục phù hợp; việc lập lại có thể dùng quota.
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"

# Tùy chọn: file cache vector trên máy backend, không phải đường dẫn trang web hay địa chỉ vector database.
# Nếu không khai báo, code dùng .cache/ai/knowledge-index.json tính từ thư mục chạy backend.
# Thư mục chứa file phải ghi được. Khi triển khai container, dùng nơi lưu bền vững nếu muốn giữ cache.
AI_KNOWLEDGE_INDEX_PATH=".cache/ai/knowledge-index.json"

# 9. NHẬN TIỀN QR QUA SEPAY
# Luồng: khách quét QR → tiền vào tài khoản ngân hàng → SePay báo về PetCare.
# PetCare tự ghi đã thanh toán khi mã thanh toán, số tiền và các điều kiện kiểm tra đều khớp.
# Bạn cần điền: ngân hàng, số tài khoản, tên chủ tài khoản và HMAC Secret lấy trên SePay.
# Nếu đang thử bằng Test mode, dùng thông tin tài khoản thử và secret của đúng Test mode.

# Mã ngân hàng nhận tiền để tạo QR. Ví dụ dùng MB thì điền MBBank.
SEPAY_BANK_CODE=

# Tên ngân hàng hiện trên màn thanh toán. Ví dụ MBBank.
SEPAY_BANK_NAME=

# Số tài khoản khách sẽ chuyển tiền vào. Chép đúng số tài khoản nhận trên SePay.
SEPAY_ACCOUNT_NUMBER=

your-sepay-account-number
SEPAY_ACCOUNT_NAME=

your-sepay-account-name
# Chỉ điền nếu bạn đã đăng ký một số nhận tiền riêng (tài khoản ảo/VA) nối với tài khoản chính.
# Khi dùng VA: điền số nhận riêng ở SEPAY_ACCOUNT_NUMBER; điền số tài khoản chính ở ô này.
SEPAY_MAIN_ACCOUNT_NUMBER=

your-sepay-account-number
# Trên SePay: tạo webhook → chọn HMAC-SHA256 → chép HMAC Secret vào ô này.
# Không dán số tài khoản, URL Cloudflare hoặc SePay API key vào đây.
# URL webhook điền trên trang SePay, không điền trong ô này:
# https://TEN-MIEN.trycloudflare.com/api/v1/payment/sepay/webhook
# Mỗi lần URL Cloudflare đổi, sửa lại URL trên SePay. Lưu .env xong thì chạy lại backend.
SEPAY_WEBHOOK_SECRET=
your-sepay-webhook-secret